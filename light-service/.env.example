SUPABASE_URL=https://your-existing-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-existing-project-service-role-key
# Match the existing website admin password. This service has no fallback password.
ADMIN_PASSWORD=replace-with-existing-admin-password
LIGHT_SIGNING_PRIVATE_KEY=replace-with-P256-PKCS8-PEM-using-literal-backslash-n
LIGHT_ALLOWED_ORIGINS=https://boothphototags.vercel.app,https://www.phototags.app,https://phototags.app
LIGHT_BOOTH_URL=https://boothphototags.vercel.app
LIGHT_OFFLINE_DAYS=7
# Use the same merchant account if desired, but configure its key in this service independently.
LIGHT_PAYMONGO_SECRET_KEY=replace-with-test-key-for-validation-first
LIGHT_PAYMONGO_WEBHOOK_SECRET=replace-with-secret-for-Light-only-webhook
